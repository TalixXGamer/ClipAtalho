@echo off
setlocal
cd /d "%~dp0"
title Compilar ClipAtalho 1.0.0
set "SRC=ClipAtalho.cs"
set "EXE=ClipAtalho.exe"
set "ICO=%TEMP%\ClipAtalho_icone.ico"

set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"
if not exist "%CSC%" (
  echo [ERRO] Nao encontrei o compilador csc.exe do .NET Framework 4 neste Windows.
  pause
  exit /b 1
)
if not exist "%SRC%" (
  echo [ERRO] Coloque o arquivo "%SRC%" na mesma pasta deste .bat.
  pause
  exit /b 1
)

rem Fecha qualquer versao do ClipAtalho que esteja aberta
taskkill /f /im "ClipAtalho*" >nul 2>&1

rem Recria o icone do programa (guardado no final deste arquivo) para usar no .exe
set ICOARG=
del "%ICO%" "%ICO%.b64" >nul 2>&1
(for /f "usebackq tokens=1,* delims=:" %%a in (`findstr /b "::ICO:" "%~f0"`) do echo %%b)>"%ICO%.b64"
certutil -f -decode "%ICO%.b64" "%ICO%" >nul 2>&1
if exist "%ICO%" (set ICOARG="/win32icon:%ICO%") else (echo Aviso: nao foi possivel gerar o icone; o .exe sai com o icone padrao.)

rem Pasta do programa: tudo do ClipAtalho fica junto dentro de "ClipAtalho"
set "DIR=ClipAtalho"
if not exist "%DIR%" mkdir "%DIR%"
rem Traz os dados das versoes anteriores (so se ainda nao existirem dentro da pasta)
for %%F in ("ClipAtalho.ini" "ClipAtalho.local.ini" "ClipAtalho.log" "ClipAtalho.clips") do (
  if exist "%%~F" if not exist "%DIR%\%%~F" move "%%~F" "%DIR%\" >nul
)
if exist "ClipAtalho imagens\" if not exist "%DIR%\ClipAtalho imagens\" move "ClipAtalho imagens" "%DIR%\" >nul

rem Remove executaveis de versoes antigas (os dados ficam)
del "%DIR%\ClipAtalho V*.exe" >nul 2>&1

echo Compilando %SRC% ...
"%CSC%" /nologo /codepage:65001 /target:winexe /optimize+ %ICOARG% "/out:%DIR%\%EXE%" "%SRC%"
set ERR=%ERRORLEVEL%
del "%ICO%" "%ICO%.b64" >nul 2>&1
if not "%ERR%"=="0" (
  echo.
  echo [ERRO] A compilacao falhou. Copie as mensagens acima e envie ao desenvolvedor.
  pause
  exit /b 1
)

echo.
echo OK! "%EXE%" criado na pasta "%DIR%". Abrindo...
start "" /d "%~dp0%DIR%" "%~dp0%DIR%\%EXE%"
timeout /t 4 >nul
exit /b 0

